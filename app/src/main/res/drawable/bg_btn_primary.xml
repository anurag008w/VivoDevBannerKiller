<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#60A5FA">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#2563EB"
                android:endColor="#4F46E5"
